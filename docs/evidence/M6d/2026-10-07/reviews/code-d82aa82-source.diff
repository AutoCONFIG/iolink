@@ -0,0 +1,143 @@
+openapi: 3.0.3
+info:
+  title: IOLink Open API
+  version: 0.0.10
+  description: Third party API authenticated with per-tenant HMAC API keys.
+servers:
+  - url: /
+security:
+  - OpenSignature: []
+paths:
+  /open/v1/ponds:
+    get:
+      summary: List ponds in the API key resource set
+      responses:
+        '200': {description: Ponds, content: {application/json: {schema: {type: array, items: {$ref: '#/components/schemas/Pond'}}}}}
+        '401': {description: "Invalid signature, timestamp, or nonce", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '403': {description: "Scope or feature unavailable", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '429': {description: "Rate limit exceeded", headers: {Retry-After: {schema: {type: integer}}}, content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+  /open/v1/ponds/{id}:
+    get:
+      summary: Get an authorized pond; inaccessible resources return 404
+      parameters:
+        - {name: id, in: path, required: true, schema: {type: integer, format: int64, minimum: 1}}
+      responses:
+        '200': {description: Pond, content: {application/json: {schema: {$ref: '#/components/schemas/Pond'}}}}
+        '401': {$ref: '#/components/responses/Unauthorized'}
+        '403': {$ref: '#/components/responses/Forbidden'}
+        '404': {$ref: '#/components/responses/NotFound'}
+        '413': {$ref: '#/components/responses/TooLarge'}
+        '429': {$ref: '#/components/responses/RateLimited'}
+  /open/v1/devices/{device_no}:
+    get:
+      summary: Get an authorized device; inaccessible resources return 404
+      parameters:
+        - {name: device_no, in: path, required: true, schema: {type: string, minLength: 1}}
+      responses:
+        '200': {description: Device, content: {application/json: {schema: {$ref: '#/components/schemas/Device'}}}}
+        '401': {$ref: '#/components/responses/Unauthorized'}
+        '403': {$ref: '#/components/responses/Forbidden'}
+        '404': {$ref: '#/components/responses/NotFound'}
+        '413': {$ref: '#/components/responses/TooLarge'}
+        '429': {$ref: '#/components/responses/RateLimited'}
+  /open/v1/devices:
+    get:
+      summary: List devices in the API key resource set
+      responses:
+        '200': {description: Devices, content: {application/json: {schema: {type: array, items: {$ref: '#/components/schemas/Device'}}}}}
+        '401': {description: "Invalid signature, timestamp, or nonce", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '403': {description: "Scope or feature unavailable", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '429': {description: "Rate limit exceeded", headers: {Retry-After: {schema: {type: integer}}}, content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+  /open/v1/alarms:
+    get:
+      summary: List alarms in the API key resource set
+      responses:
+        '200': {description: Alarms, content: {application/json: {schema: {type: array, items: {$ref: '#/components/schemas/Alarm'}}}}}
+        '401': {description: "Invalid signature, timestamp, or nonce", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '403': {description: "Scope or feature unavailable", content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+        '429': {description: "Rate limit exceeded", headers: {Retry-After: {schema: {type: integer}}}, content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}}
+components:
+  responses:
+    Unauthorized:
+      description: Invalid signature, timestamp, nonce, revoked key or inactive tenant
+      content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}
+    Forbidden:
+      description: Scope or feature unavailable
+      content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}
+    NotFound:
+      description: Missing or unauthorized resource
+      content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}
+    TooLarge:
+      description: Request body exceeds 4 MiB; no authentication or nonce consumption
+      content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}
+    RateLimited:
+      description: Rate limit exceeded
+      headers: {Retry-After: {schema: {type: integer, minimum: 1}}}
+      content: {application/json: {schema: {$ref: '#/components/schemas/Error'}}}
+  schemas:
+    Error:
+      type: object
+      required: [error]
+      properties:
+        error: {type: string}
+    Pond:
+      type: object
+      required: [id, farm_id, name, area_mu, created_at]
+      properties:
+        id: {type: integer, format: int64}
+        farm_id: {type: integer, format: int64}
+        name: {type: string}
+        area_mu: {type: number, format: double}
+        created_at: {type: string, format: date-time}
+    Device:
+      type: object
+      required: [id, pond_id, device_no, name, model, status, report_interval, created_at]
+      properties:
+        id: {type: integer, format: int64}
+        pond_id: {type: integer, format: int64}
+        device_no: {type: string}
+        name: {type: string}
+        model: {type: string}
+        status: {type: string}
+        last_seen_at: {type: string, format: date-time, nullable: true}
+        created_at: {type: string, format: date-time}
+        disabled_at: {type: string, format: date-time, nullable: true}
+        report_interval: {type: integer}
+    Alarm:
+      type: object
+      required: [id, device_no, pond_id, metric, current_value, threshold, level, message, created_at]
+      properties:
+        id: {type: integer, format: int64}
+        device_no: {type: string}
+        pond_id: {type: integer, format: int64}
+        metric: {type: string}
+        current_value: {type: number, format: double}
+        threshold: {type: number, format: double}
+        level: {type: string}
+        message: {type: string}
+        confirmed_at: {type: string, format: date-time, nullable: true}
+        created_at: {type: string, format: date-time}
+  securitySchemes:
+    OpenSignature:
+      type: apiKey
+      in: header
+      name: X-Signature
+      description: |-
+        Send X-Key-Id, X-Timestamp, X-Nonce and lowercase hex X-Signature.
+        Sign METHOD, raw path, RFC3986 sorted query, timestamp, nonce and
+        lowercase SHA-256 body hash joined by LF without a trailing LF.
+x-signature-vector:
+  method: GET
+  path: /open/v1/ponds
+  query: a=&a=hello%20world&b=one&b=two
+  timestamp: 1735689600
+  nonce: 0123456789abcdef0123456789abcdef
+  body_sha256: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
+  signing_key: documented-test-secret
+  signature: bcf8386ae0789327c5a6597a81eaa2f3121565d045012796e7e22bdba2a43149
+  curl: >-
+    curl -sS 'http://localhost:8080/open/v1/ponds?a=&a=hello%20world&b=one&b=two'
+    -H 'X-Key-Id: ik_documented'
+    -H 'X-Timestamp: 1735689600'
+    -H 'X-Nonce: 0123456789abcdef0123456789abcdef'
+    -H 'X-Signature: bcf8386ae0789327c5a6597a81eaa2f3121565d045012796e7e22bdba2a43149'
